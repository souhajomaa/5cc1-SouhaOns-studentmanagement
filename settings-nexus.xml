<?xml version="1.0" encoding="UTF-8"?>
<!-- settings-nexus.xml : utilisé par Jenkins avec "mvn -s settings-nexus.xml".
     Aucun secret ici : les variables NEXUS_USER / NEXUS_PASS sont injectées
     par withCredentials dans le Jenkinsfile (credential Jenkins "nexus"). -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <servers>
    <server>
      <id>deploymentRepo</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASS}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <mirrorOf>central</mirrorOf>
      <url>http://localhost:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>
</settings>
